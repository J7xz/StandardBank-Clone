@{
    ViewBag.Title = "Create Broadcast";
    ViewBag.SubTitle = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header {
        margin-bottom: 28px;
    }

        .page-header h1 {
            font-size: 24px;
            font-weight: 700;
            color: #0a1628;
            margin: 0;
        }

        .page-header p {
            color: #6b7a8f;
            font-size: 14px;
            margin: 4px 0 0;
        }

    .form-card {
        background: #fff;
        border-radius: 14px;
        border: 1px solid #eaedf2;
        padding: 28px 32px;
        max-width: 600px;
        margin: 0 auto;
    }

        .form-card .form-group {
            margin-bottom: 18px;
        }

            .form-card .form-group label {
                font-size: 13px;
                font-weight: 600;
                color: #0a1628;
                display: block;
                margin-bottom: 4px;
            }

            .form-card .form-group .form-control {
                width: 100%;
                padding: 10px 14px;
                border: 1px solid #eaedf2;
                border-radius: 8px;
                font-size: 14px;
                font-family: 'Inter', sans-serif;
                transition: 0.2s;
                background: #fff;
                color: #0a1628;
            }

                .form-card .form-group .form-control:focus {
                    border-color: #003399;
                    outline: none;
                    box-shadow: 0 0 0 3px rgba(0,51,153,0.06);
                }

                .form-card .form-group .form-control::placeholder {
                    color: #9aa3b3;
                }

            .form-card .form-group .hint {
                font-size: 12px;
                color: #6b7a8f;
                margin-top: 4px;
            }

        .form-card .submit-btn {
            width: 100%;
            padding: 12px;
            background: #003399;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
            margin-top: 4px;
        }

            .form-card .submit-btn:hover {
                background: #002266;
            }

    .alert {
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 16px;
        font-size: 14px;
    }

    .alert-success {
        background: #ecfdf5;
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    .alert-danger {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    .alert-warning {
        background: #fefce8;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .btn-secondary {
        padding: 10px 24px;
        background: #f0f2f7;
        color: #0a1628;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: 0.2s;
        text-decoration: none;
        display: inline-block;
    }

        .btn-secondary:hover {
            background: #e5e8ef;
        }

    @@media (max-width: 600px) {
        .form-card {
            padding: 20px;
        }
    }
</style>

<div>

    <!-- Header -->
    <div class="page-header">
        <h1>Create Broadcast</h1>
        <p>Send notification to all users</p>
    </div>

    <!-- Form -->
    <div class="form-card">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            </div>
        }

        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>
            This will send a notification to <strong>ALL</strong> users. Please use with caution.
        </div>

        @using (Html.BeginForm("CreateBroadcast", "Notification", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Title</label>
                <input type="text" name="title" class="form-control" placeholder="Enter notification title" required />
            </div>

            <div class="form-group">
                <label>Message</label>
                <textarea name="message" class="form-control" rows="4" placeholder="Enter notification message" required></textarea>
            </div>

            <div class="form-group">
                <label>Link URL (Optional)</label>
                <input type="text" name="linkUrl" class="form-control" placeholder="e.g., /Dashboard or https://..." />
                <div class="hint">Users will be directed to this link when they click the notification</div>
            </div>

            <div style="display:flex; gap:12px;">
                <button type="submit" class="submit-btn">
                    <i class="fas fa-paper-plane me-2"></i>Send Broadcast
                </button>
                <a href="@Url.Action("Index", "Admin")" class="btn-secondary">Cancel</a>
            </div>
        }

    </div>

</div>