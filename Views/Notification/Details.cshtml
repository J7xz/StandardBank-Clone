@model StandardBank.Models.Notification

@{
    ViewBag.Title = "Notification Details";
    ViewBag.SubTitle = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header {
        margin-bottom: 28px;
    }

        .page-header h1 {
            font-size: 24px;
            font-weight: 700;
            color: #0a1628;
            margin: 0;
        }

        .page-header p {
            color: #6b7a8f;
            font-size: 14px;
            margin: 4px 0 0;
        }

    .details-card {
        background: #fff;
        border-radius: 14px;
        border: 1px solid #eaedf2;
        padding: 28px 32px;
        max-width: 600px;
        margin: 0 auto;
    }

        .details-card .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
            flex-wrap: wrap;
            gap: 8px;
        }

            .details-card .header .title {
                font-size: 20px;
                font-weight: 700;
                color: #0a1628;
            }

            .details-card .header .badge-status {
                font-size: 12px;
                font-weight: 600;
                padding: 4px 16px;
                border-radius: 20px;
            }

                .details-card .header .badge-status.unread {
                    background: #e8f0fe;
                    color: #003399;
                }

                .details-card .header .badge-status.read {
                    background: #f0f2f7;
                    color: #6b7a8f;
                }

        .details-card .meta {
            display: flex;
            gap: 20px;
            font-size: 13px;
            color: #6b7a8f;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }

            .details-card .meta span i {
                margin-right: 4px;
            }

        .details-card .divider {
            border: none;
            border-top: 1px solid #eaedf2;
            margin: 16px 0;
        }

        .details-card .message {
            font-size: 15px;
            line-height: 1.8;
            color: #0a1628;
        }

        .details-card .actions {
            display: flex;
            gap: 10px;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #eaedf2;
            flex-wrap: wrap;
        }

            .details-card .actions .btn-primary {
                padding: 10px 24px;
                background: #003399;
                color: #fff;
                border: none;
                border-radius: 8px;
                font-size: 14px;
                font-weight: 600;
                cursor: pointer;
                transition: 0.2s;
                text-decoration: none;
                display: inline-block;
            }

                .details-card .actions .btn-primary:hover {
                    background: #002266;
                }

            .details-card .actions .btn-outline {
                padding: 10px 24px;
                background: transparent;
                border: 1px solid #eaedf2;
                border-radius: 8px;
                font-size: 14px;
                font-weight: 500;
                color: #0a1628;
                cursor: pointer;
                transition: 0.2s;
                text-decoration: none;
                display: inline-block;
            }

                .details-card .actions .btn-outline:hover {
                    border-color: #003399;
                    color: #003399;
                }

                .details-card .actions .btn-outline.danger {
                    border-color: #dc2626;
                    color: #dc2626;
                }

                    .details-card .actions .btn-outline.danger:hover {
                        background: #dc2626;
                        color: #fff;
                    }

            .details-card .actions .btn-link {
                padding: 10px 16px;
                background: transparent;
                border: none;
                color: #6b7a8f;
                cursor: pointer;
                transition: 0.2s;
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                margin-left: auto;
            }

                .details-card .actions .btn-link:hover {
                    color: #0a1628;
                }

    @@media (max-width: 600px) {
        .details-card {
            padding: 20px;
        }

            .details-card .actions {
                flex-direction: column;
            }

                .details-card .actions .btn-link {
                    margin-left: 0;
                }
    }
</style>

<div>

    <!-- Header -->
    <div class="page-header">
        <h1>Notification Details</h1>
        <p>@Model.Title</p>
    </div>

    <!-- Details -->
    <div class="details-card">

        <div class="header">
            <span class="title">@Model.Title</span>
            <span class="badge-status @(Model.IsRead ? "read" : "unread")">
                @(Model.IsRead ? "Read" : "Unread")
            </span>
        </div>

        <div class="meta">
            <span><i class="fas fa-clock"></i>@Model.DateSent.ToString("dd MMM yyyy HH:mm")</span>
            <span><i class="fas fa-tag"></i>@Model.NotificationType</span>
        </div>

        <hr class="divider" />

        <div class="message">@Model.Message</div>

        @if (!string.IsNullOrEmpty(Model.LinkUrl))
        {
            <div style="margin-top:16px;">
                <a href="@Model.LinkUrl" class="btn-primary" style="display:inline-block;">
                    <i class="fas fa-arrow-right me-2"></i>Go to Link
                </a>
            </div>
        }

        <div class="actions">
            @if (!Model.IsRead)
            {
                <button onclick="markAsRead(@Model.Id)" class="btn-primary">
                    <i class="fas fa-check me-2"></i>Mark as Read
                </button>
            }
            <button onclick="deleteNotification(@Model.Id)" class="btn-outline danger">
                <i class="fas fa-trash me-2"></i>Delete
            </button>
            <a href="@Url.Action("Index", "Notification")" class="btn-link">
                <i class="fas fa-arrow-left me-2"></i>Back
            </a>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        function markAsRead(id) {
            $.ajax({
                url: '@Url.Action("MarkAsRead", "Notification")',
                type: 'POST',
                data: { id: id },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert('Failed to mark notification as read.');
                    }
                },
                error: function() {
                    alert('An error occurred. Please try again.');
                }
            });
        }

        function deleteNotification(id) {
            if (!confirm('Delete this notification?')) return;

            $.ajax({
                url: '@Url.Action("Delete", "Notification")',
                type: 'POST',
                data: { id: id },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        window.location.href = '@Url.Action("Index", "Notification")';
                    } else {
                        alert('Failed to delete notification.');
                    }
                },
                error: function() {
                    alert('An error occurred. Please try again.');
                }
            });
        }
    </script>
}