@model StandardBank.ViewModels.TransactionMonitoringViewModel

@{
    ViewBag.Title = "Transactions";
    ViewBag.SubTitle = "View all transactions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .top-header .header-right .search-box {
        display: none !important;
    }

    .page-header {
        margin-bottom: 28px;
    }

        .page-header h1 {
            font-size: 24px;
            font-weight: 700;
            color: #0a1628;
            margin: 0;
        }

        .page-header p {
            color: #6b7a8f;
            font-size: 14px;
            margin: 4px 0 0;
        }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .stat-box {
        background: #fff;
        border-radius: 12px;
        padding: 16px 20px;
        border: 1px solid #eaedf2;
    }

        .stat-box .label {
            font-size: 12px;
            font-weight: 500;
            color: #6b7a8f;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-box .number {
            font-size: 24px;
            font-weight: 700;
            color: #0a1628;
            margin: 2px 0;
        }

        .stat-box .sub {
            font-size: 13px;
            color: #6b7a8f;
        }

    .filter-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #eaedf2;
        padding: 16px 20px;
        margin-bottom: 24px;
    }

        .filter-card .row {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: flex-end;
        }

        .filter-card .form-group {
            flex: 1;
            min-width: 140px;
        }

            .filter-card .form-group label {
                font-size: 12px;
                font-weight: 600;
                color: #0a1628;
                display: block;
                margin-bottom: 3px;
            }

            .filter-card .form-group .form-control,
            .filter-card .form-group .form-select {
                width: 100%;
                padding: 8px 12px;
                border: 1px solid #eaedf2;
                border-radius: 8px;
                font-size: 13px;
                font-family: 'Inter', sans-serif;
                background: #fff;
                color: #0a1628;
                transition: 0.2s;
            }

                .filter-card .form-group .form-control:focus,
                .filter-card .form-group .form-select:focus {
                    border-color: #003399;
                    outline: none;
                    box-shadow: 0 0 0 3px rgba(0,51,153,0.06);
                }

        .filter-card .btn-filter {
            padding: 8px 20px;
            background: #003399;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
        }

            .filter-card .btn-filter:hover {
                background: #002266;
            }

        .filter-card .btn-reset {
            padding: 8px 16px;
            background: #f0f2f7;
            color: #0a1628;
            border: none;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: 0.2s;
            text-decoration: none;
            display: inline-block;
        }

            .filter-card .btn-reset:hover {
                background: #e5e8ef;
            }

    .table-wrap {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #eaedf2;
        overflow: hidden;
    }

        .table-wrap table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

            .table-wrap table th {
                background: #f8fafc;
                color: #6b7a8f;
                font-weight: 600;
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                padding: 10px 16px;
                text-align: left;
                border-bottom: 1px solid #eaedf2;
            }

            .table-wrap table td {
                padding: 10px 16px;
                border-bottom: 1px solid #f5f7fa;
                vertical-align: middle;
            }

            .table-wrap table tr:last-child td {
                border-bottom: none;
            }

            .table-wrap table tr:hover td {
                background: #fafbfc;
            }

    .badge-type {
        font-size: 10px;
        font-weight: 600;
        padding: 3px 12px;
        border-radius: 20px;
    }

        .badge-type.credit {
            background: #dcfce7;
            color: #166534;
        }

        .badge-type.debit {
            background: #fee2e2;
            color: #991b1b;
        }

    .badge-status {
        font-size: 10px;
        font-weight: 600;
        padding: 3px 12px;
        border-radius: 20px;
    }

        .badge-status.completed {
            background: #dcfce7;
            color: #166534;
        }

        .badge-status.pending {
            background: #fef3c7;
            color: #92400e;
        }

        .badge-status.failed {
            background: #fee2e2;
            color: #991b1b;
        }

    .empty-state {
        padding: 48px 20px;
        text-align: center;
        color: #6b7a8f;
    }

        .empty-state i {
            font-size: 36px;
            opacity: 0.15;
            display: block;
            margin-bottom: 10px;
        }

        .empty-state .main {
            font-size: 15px;
            font-weight: 500;
            color: #0a1628;
        }

    .btn-sm {
        padding: 4px 10px;
        font-size: 12px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn-danger-sm {
        background: #fee2e2;
        color: #991b1b;
    }

        .btn-danger-sm:hover {
            background: #fecaca;
        }

    .filter-badge {
        background: #e8f0fe;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 13px;
        color: #003399;
        margin-bottom: 16px;
        display: inline-block;
    }

    @@media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .filter-card .form-group {
            min-width: 100%;
        }

        .table-wrap table {
            font-size: 12px;
        }
    }

    @@media (max-width: 480px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div>

    <!-- Header -->
    <div class="page-header">
        <h1>Transaction Monitoring</h1>
        <p>View and filter all system transactions</p>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
        <div class="stat-box">
            <div class="label">Total Transactions</div>
            <div class="number">@Model.TotalTransactions</div>
        </div>
        <div class="stat-box">
            <div class="label">Total Amount</div>
            <div class="number" style="color:#003399;">@Model.TotalAmount.ToString("C")</div>
        </div>
        <div class="stat-box">
            <div class="label">Average Amount</div>
            <div class="number">
                @(Model.TotalTransactions > 0 ? (Model.TotalAmount / Model.TotalTransactions).ToString("C") : "R0.00")
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="filter-card">
        @using (Html.BeginForm("Transactions", "Admin", FormMethod.Get))
        {
            <div class="row">
                <div class="form-group">
                    <label>Account Number</label>
                    <input type="text" name="SearchTerm" class="form-control" placeholder="Enter account number..." value="" />
                </div>
                <div class="form-group">
                    <label>From Date</label>
                    <input type="date" name="FromDate" class="form-control" value="@(Model.Filter?.FromDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="form-group">
                    <label>To Date</label>
                    <input type="date" name="ToDate" class="form-control" value="@(Model.Filter?.ToDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="form-group">
                    <label>Type</label>
                    <select name="TransactionType" class="form-select">
                        <option value="">All</option>
                        <option value="Credit" @(Model.Filter?.TransactionType == "Credit" ? "selected" : "")>Credit</option>
                        <option value="Debit" @(Model.Filter?.TransactionType == "Debit" ? "selected" : "")>Debit</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Status</label>
                    <select name="Status" class="form-select">
                        <option value="">All</option>
                        <option value="Completed" @(Model.Filter?.Status == "Completed" ? "selected" : "")>Completed</option>
                        <option value="Pending" @(Model.Filter?.Status == "Pending" ? "selected" : "")>Pending</option>
                        <option value="Failed" @(Model.Filter?.Status == "Failed" ? "selected" : "")>Failed</option>
                    </select>
                </div>
                <div class="form-group" style="flex: 0 0 auto;">
                    <button type="submit" class="btn-filter">
                        <i class="fas fa-search me-2"></i>Filter
                    </button>
                    <a href="@Url.Action("Transactions", "Admin")" class="btn-reset">
                        <i class="fas fa-undo me-2"></i>Reset
                    </a>
                </div>
            </div>
        }
    </div>

    <!-- Filter Badge -->
    @if (!string.IsNullOrEmpty(Model.Filter?.SearchTerm))
    {
        <div class="filter-badge">
            <i class="fas fa-filter me-2"></i>Searching for account: <strong>@Model.Filter.SearchTerm</strong>
        </div>
    }

    <!-- Transactions Table -->
    <div class="table-wrap">
        @if (Model.Transactions != null && Model.Transactions.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>User</th>
                        <th>Account</th>
                        <th>Description</th>
                        <th>Amount</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th style="text-align:center;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Transactions)
                    {
                        <tr>
                            <td><small>@t.TransactionDate.ToString("dd MMM yyyy HH:mm")</small></td>
                            <td>
                                @if (t.Account != null && t.Account.User != null)
                                {
                                    <span style="font-weight:600; color:#0a1628;">@t.Account.User.FullName</span>
                                    <small style="display:block; color:#6b7a8f;">@t.Account.User.Email</small>
                                }
                                else
                                {
                                    <span style="color:#6b7a8f;">N/A</span>
                                }
                            </td>
                            <td>
                                @if (t.Account != null)
                                {
                                    <span style="font-weight:600; color:#0a1628;">@t.Account.AccountNumber</span>
                                }
                                else
                                {
                                    <span style="color:#6b7a8f;">N/A</span>
                                }
                            </td>
                            <td><small>@t.Description</small></td>
                            <td style="font-weight:600; color:@(t.TransactionType == "Credit" ? "#16a34a" : "#dc2626");">
                                @(t.TransactionType == "Credit" ? "+" : "-")@t.Amount.ToString("C")
                            </td>
                            <td>
                                <span class="badge-type @(t.TransactionType == "Credit" ? "credit" : "debit")">@t.TransactionType</span>
                            </td>
                            <td>
                                <span class="badge-status @(t.Status?.ToLower() == "completed" ? "completed" : t.Status?.ToLower() == "pending" ? "pending" : "failed")">
                                    @t.Status
                                </span>
                            </td>
                            <td style="text-align:center;">
                                @using (Html.BeginForm("DeleteTransaction", "Admin", new { id = t.Id }, FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-sm btn-danger-sm" onclick="return confirm('Are you sure you want to delete this transaction?')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-exchange-alt"></i>
                <div class="main">No transactions found</div>
                <div style="font-size:13px; color:#6b7a8f; margin-top:4px;">
                    Try adjusting your filters or create some transactions first
                </div>
            </div>
        }
    </div>

</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var searchBox = document.querySelector('.top-header .header-right .search-box');
        if (searchBox) {
            searchBox.style.display = 'none';
        }
    });
</script>