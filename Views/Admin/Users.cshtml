@{
    ViewBag.Title = "Reports";
    ViewBag.SubTitle = "Generate and export reports";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="animate-fade-in">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card card-elegant">
                <div class="card-header">
                    <i class="fas fa-file-pdf me-2"></i>Generate Report
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("GenerateReport", "Admin", FormMethod.Get))
                    {
                        <div class="mb-3">
                            <label class="form-label">Report Type</label>
                            <select name="reportType" class="form-select">
                                <option value="TransactionReport">Transaction Report</option>
                                <option value="UserReport">User Report</option>
                                <option value="FinancialReport">Financial Summary</option>
                            </select>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">From Date</label>
                                <input type="date" name="fromDate" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">To Date</label>
                                <input type="date" name="toDate" class="form-control" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">
                            <i class="fas fa-file-export me-2"></i>Generate Report
                        </button>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card card-elegant">
                <div class="card-header">
                    <i class="fas fa-download me-2"></i>Quick Reports
                </div>
                <div class="card-body">
                    <div class="list-group">
                        <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                <i class="fas fa-file-excel text-success me-2"></i>
                                <span>Export User List</span>
                            </div>
                            <i class="fas fa-download text-muted"></i>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                <i class="fas fa-file-excel text-success me-2"></i>
                                <span>Export Transaction History</span>
                            </div>
                            <i class="fas fa-download text-muted"></i>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                <i class="fas fa-file-pdf text-danger me-2"></i>
                                <span>Monthly Financial Summary</span>
                            </div>
                            <i class="fas fa-download text-muted"></i>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                <i class="fas fa-file-pdf text-danger me-2"></i>
                                <span>Audit Report</span>
                            </div>
                            <i class="fas fa-download text-muted"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>