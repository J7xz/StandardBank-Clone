
@model IEnumerable<StandardBank.Models.AdminLog>

@{
    ViewBag.Title = "Admin Logs";
    ViewBag.SubTitle = "View all admin activity";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header {
        margin-bottom: 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }

        .page-header h1 {
            font-size: 24px;
            font-weight: 700;
            color: #0a1628;
            margin: 0;
        }

        .page-header p {
            color: #6b7a8f;
            font-size: 14px;
            margin: 4px 0 0;
        }

    .table-wrap {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #eaedf2;
        overflow: hidden;
    }

        .table-wrap table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

            .table-wrap table th {
                background: #f8fafc;
                color: #6b7a8f;
                font-weight: 600;
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                padding: 10px 16px;
                text-align: left;
                border-bottom: 1px solid #eaedf2;
            }

            .table-wrap table td {
                padding: 10px 16px;
                border-bottom: 1px solid #f5f7fa;
                vertical-align: middle;
            }

            .table-wrap table tr:last-child td {
                border-bottom: none;
            }

            .table-wrap table tr:hover td {
                background: #fafbfc;
            }

    .badge-action {
        font-size: 10px;
        font-weight: 600;
        padding: 3px 12px;
        border-radius: 20px;
        background: #e8f0fe;
        color: #003399;
    }

        .badge-action.danger {
            background: #fee2e2;
            color: #991b1b;
        }

        .badge-action.success {
            background: #dcfce7;
            color: #166534;
        }

        .badge-action.warning {
            background: #fef3c7;
            color: #92400e;
        }

    .btn-danger {
        padding: 8px 20px;
        background: #dc2626;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn-danger:hover {
            background: #b91c1c;
        }

    .empty-state {
        padding: 48px 20px;
        text-align: center;
        color: #6b7a8f;
    }

        .empty-state i {
            font-size: 36px;
            opacity: 0.15;
            display: block;
            margin-bottom: 10px;
        }

        .empty-state .main {
            font-size: 15px;
            font-weight: 500;
            color: #0a1628;
        }

    .pagination-wrap {
        display: flex;
        justify-content: center;
        gap: 6px;
        margin-top: 20px;
    }

        .pagination-wrap a {
            padding: 6px 14px;
            border-radius: 6px;
            font-size: 13px;
            text-decoration: none;
            color: #6b7a8f;
            border: 1px solid #eaedf2;
            background: #fff;
            transition: 0.2s;
        }

            .pagination-wrap a:hover {
                border-color: #003399;
                color: #003399;
            }

            .pagination-wrap a.active {
                background: #003399;
                color: #fff;
                border-color: #003399;
            }

    @@media (max-width: 768px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .table-wrap table {
            font-size: 12px;
        }

            .table-wrap table th,
            .table-wrap table td {
                padding: 6px 10px;
            }
    }
</style>

<div>

    <!-- Header -->
    <div class="page-header">
        <div>
            <h1>Admin Logs</h1>
            <p>View all admin activity</p>
        </div>
        <div>
            <span style="color: #6b7a8f; font-size: 14px; margin-right: 16px;">
                Total Logs: @ViewBag.TotalLogs
            </span>
            @using (Html.BeginForm("ClearLogs", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-danger" onclick="return confirm('Are you sure you want to clear all logs? This cannot be undone.')">
                    <i class="fas fa-trash me-2"></i>Clear All Logs
                </button>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" style="padding:12px 16px; border-radius:8px; background:#ecfdf5; color:#166534; border:1px solid #bbf7d0; margin-bottom:16px;">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        </div>
    }

    <!-- Logs Table -->
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>Action</th>
                    <th>Details</th>
                    <th>IP Address</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var log in Model)
                    {
                        var actionClass = log.Action == "LockUser" || log.Action == "DeleteTransaction" ? "danger" :
                                          log.Action == "UnlockUser" || log.Action == "GenerateReport" ? "success" : "";
                        <tr>
                            <td><small>@log.Timestamp.ToString("dd MMM yyyy HH:mm:ss")</small></td>
                            <td><span class="badge-action @actionClass">@log.Action</span></td>
                            <td><small>@log.Details</small></td>
                            <td><small>@log.IPAddress</small></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4">
                            <div class="empty-state">
                                <i class="fas fa-history"></i>
                                <div class="main">No admin logs found</div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="pagination-wrap">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <a href="@Url.Action("Logs", "Admin", new { page = i, pageSize = ViewBag.PageSize })" class="@(i == ViewBag.CurrentPage ? "active" : "")">@i</a>
            }
        </div>
    }

</div>