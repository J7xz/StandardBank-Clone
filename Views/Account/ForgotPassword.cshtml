@{
    ViewBag.Title = "Forgot Password Confirmation";
    ViewBag.SubTitle = "";
    Layout = "~/Views/Shared/_LayoutLanding.cshtml";
}

<style>
    .confirmation-card {
        background: #fff;
        border-radius: 14px;
        border: 1px solid #eaedf2;
        padding: 40px 32px;
        max-width: 480px;
        margin: 40px auto;
        text-align: center;
    }

        .confirmation-card .icon {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: #ecfdf5;
            color: #16a34a;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            margin: 0 auto 16px;
        }

        .confirmation-card h1 {
            font-size: 24px;
            font-weight: 700;
            color: #0a1628;
            margin: 0 0 8px;
        }

        .confirmation-card p {
            color: #6b7a8f;
            font-size: 15px;
            margin: 0 0 20px;
        }

        .confirmation-card .btn {
            display: inline-block;
            padding: 10px 32px;
            background: #003399;
            color: #fff;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            transition: 0.2s;
        }

            .confirmation-card .btn:hover {
                background: #002266;
            }

    @@media (max-width: 600px) {
        .confirmation-card {
            padding: 24px 20px;
            margin: 20px 12px;
        }
    }
</style>

<div class="confirmation-card">
    <div class="icon">
        <i class="fas fa-envelope"></i>
    </div>
    <h1>Check Your Email</h1>
    <p>We've sent password reset instructions to your email address. Please check your inbox.</p>
    <a href="@Url.Action("Login", "Account")" class="btn">
        <i class="fas fa-arrow-left me-2"></i>Back to Login
    </a>
</div>