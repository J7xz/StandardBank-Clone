@model StandardBank.ViewModels.ChangePasswordViewModel

@{
    ViewBag.Title = "Change Password";
    ViewBag.SubTitle = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header {
        margin-bottom: 28px;
    }

        .page-header h1 {
            font-size: 24px;
            font-weight: 700;
            color: #0a1628;
            margin: 0;
        }

        .page-header p {
            color: #6b7a8f;
            font-size: 14px;
            margin: 4px 0 0;
        }

    .form-card {
        background: #fff;
        border-radius: 14px;
        border: 1px solid #eaedf2;
        padding: 28px 32px;
        max-width: 600px;
        margin: 0 auto;
    }

        .form-card .form-group {
            margin-bottom: 18px;
        }

            .form-card .form-group label {
                font-size: 13px;
                font-weight: 600;
                color: #0a1628;
                display: block;
                margin-bottom: 4px;
            }

            .form-card .form-group .form-control {
                width: 100%;
                padding: 10px 14px;
                border: 1px solid #eaedf2;
                border-radius: 8px;
                font-size: 14px;
                font-family: 'Inter', sans-serif;
                transition: 0.2s;
                background: #fff;
                color: #0a1628;
            }

                .form-card .form-group .form-control:focus {
                    border-color: #003399;
                    outline: none;
                    box-shadow: 0 0 0 3px rgba(0,51,153,0.06);
                }

                .form-card .form-group .form-control::placeholder {
                    color: #9aa3b3;
                }

            .form-card .form-group .hint {
                font-size: 12px;
                color: #6b7a8f;
                margin-top: 4px;
            }

        .form-card .password-input {
            position: relative;
        }

            .form-card .password-input .icon {
                position: absolute;
                left: 14px;
                top: 50%;
                transform: translateY(-50%);
                color: #6b7a8f;
                font-size: 15px;
            }

            .form-card .password-input input {
                padding-left: 40px;
            }

            .form-card .password-input .toggle-password {
                position: absolute;
                right: 14px;
                top: 50%;
                transform: translateY(-50%);
                background: none;
                border: none;
                color: #6b7a8f;
                cursor: pointer;
                font-size: 14px;
                padding: 4px;
            }

                .form-card .password-input .toggle-password:hover {
                    color: #0a1628;
                }

        .form-card .submit-btn {
            width: 100%;
            padding: 12px;
            background: #003399;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
            margin-top: 4px;
        }

            .form-card .submit-btn:hover {
                background: #002266;
            }

    .alert {
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 16px;
        font-size: 14px;
    }

    .alert-success {
        background: #ecfdf5;
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    .alert-danger {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    .alert-info {
        background: #e8f0fe;
        color: #003399;
        border: 1px solid #c5d5f0;
    }

    .text-danger {
        color: #dc2626;
        font-size: 13px;
        margin-top: 4px;
        display: block;
    }

    .btn-secondary {
        padding: 10px 24px;
        background: #f0f2f7;
        color: #0a1628;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: 0.2s;
        text-decoration: none;
        display: inline-block;
    }

        .btn-secondary:hover {
            background: #e5e8ef;
        }

    @@media (max-width: 600px) {
        .form-card {
            padding: 20px;
        }
    }
</style>

<div>

    <!-- Header -->
    <div class="page-header">
        <h1>Change Password</h1>
        <p>Update your security credentials</p>
    </div>

    <!-- Form -->
    <div class="form-card">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            </div>
        }

        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            Password must be at least 6 characters long and contain a digit, lowercase, and uppercase letter.
        </div>

        @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                @Html.LabelFor(m => m.CurrentPassword, "Current Password")
                <div class="password-input">
                    <span class="icon"><i class="fas fa-lock"></i></span>
                    @Html.PasswordFor(m => m.CurrentPassword, new { @class = "form-control", placeholder = "Enter current password", id = "CurrentPassword" })
                    <button type="button" class="toggle-password" onclick="togglePassword('CurrentPassword', this)">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
                @Html.ValidationMessageFor(m => m.CurrentPassword, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.NewPassword, "New Password")
                <div class="password-input">
                    <span class="icon"><i class="fas fa-key"></i></span>
                    @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", placeholder = "Enter new password", id = "NewPassword" })
                    <button type="button" class="toggle-password" onclick="togglePassword('NewPassword', this)">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.ConfirmPassword, "Confirm New Password")
                <div class="password-input">
                    <span class="icon"><i class="fas fa-check-circle"></i></span>
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirm new password", id = "ConfirmPassword" })
                    <button type="button" class="toggle-password" onclick="togglePassword('ConfirmPassword', this)">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
            </div>

            <div style="display:flex; gap:12px;">
                <button type="submit" class="submit-btn">
                    <i class="fas fa-save me-2"></i>Update Password
                </button>
                <a href="@Url.Action("Profile", "Account")" class="btn-secondary">Cancel</a>
            </div>
        }

    </div>

</div>

<script>
    function togglePassword(inputId, button) {
        var input = document.getElementById(inputId);
        var icon = button.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'fas fa-eye-slash';
        } else {
            input.type = 'password';
            icon.className = 'fas fa-eye';
        }
    }
</script>