@model StandardBank.Models.Beneficiary

@{
    ViewBag.Title = "Edit Beneficiary";
    ViewBag.SubTitle = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header {
        margin-bottom: 28px;
    }

        .page-header h1 {
            font-size: 24px;
            font-weight: 700;
            color: #0a1628;
            margin: 0;
        }

        .page-header p {
            color: #6b7a8f;
            font-size: 14px;
            margin: 4px 0 0;
        }

    .form-card {
        background: #fff;
        border-radius: 14px;
        border: 1px solid #eaedf2;
        padding: 28px 32px;
        max-width: 600px;
        margin: 0 auto;
    }

        .form-card .form-group {
            margin-bottom: 18px;
        }

            .form-card .form-group label {
                font-size: 13px;
                font-weight: 600;
                color: #0a1628;
                display: block;
                margin-bottom: 4px;
            }

            .form-card .form-group .form-control {
                width: 100%;
                padding: 10px 14px;
                border: 1px solid #eaedf2;
                border-radius: 8px;
                font-size: 14px;
                font-family: 'Inter', sans-serif;
                transition: 0.2s;
                background: #fff;
                color: #0a1628;
            }

                .form-card .form-group .form-control:focus {
                    border-color: #003399;
                    outline: none;
                    box-shadow: 0 0 0 3px rgba(0,51,153,0.06);
                }

            .form-card .form-group .hint {
                font-size: 12px;
                color: #6b7a8f;
                margin-top: 4px;
            }

        .form-card .submit-btn {
            width: 100%;
            padding: 12px;
            background: #003399;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
            margin-top: 4px;
        }

            .form-card .submit-btn:hover {
                background: #002266;
            }

    .text-danger {
        color: #dc2626;
        font-size: 13px;
        margin-top: 4px;
        display: block;
    }

    @@media (max-width: 600px) {
        .form-card {
            padding: 20px;
        }
    }
</style>

<div>

    <!-- Header -->
    <div class="page-header">
        <h1>Edit Beneficiary</h1>
        <p>Update beneficiary details</p>
    </div>

    <!-- Form -->
    <div class="form-card">

        @using (Html.BeginForm("Edit", "Beneficiary", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(m => m.Id)
            @Html.HiddenFor(m => m.UserId)
            @Html.HiddenFor(m => m.DateAdded)
            @Html.HiddenFor(m => m.IsActive)

            <div class="form-group">
                @Html.LabelFor(m => m.Name, "Full Name")
                @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Nickname, "Nickname (Optional)")
                @Html.TextBoxFor(m => m.Nickname, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Nickname, "", new { @class = "text-danger" })
                <div class="hint">A nickname to easily identify this beneficiary</div>
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.AccountNumber, "Account Number")
                @Html.TextBoxFor(m => m.AccountNumber, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.AccountNumber, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.BankName, "Bank Name")
                @Html.TextBoxFor(m => m.BankName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.BankName, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="submit-btn">
                <i class="fas fa-save me-2"></i>Update Beneficiary
            </button>
        }

    </div>

</div>