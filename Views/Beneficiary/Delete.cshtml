@model StandardBank.Models.Beneficiary

@{
    ViewBag.Title = "Delete Beneficiary";
    ViewBag.SubTitle = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header {
        margin-bottom: 28px;
    }

        .page-header h1 {
            font-size: 24px;
            font-weight: 700;
            color: #0a1628;
            margin: 0;
        }

        .page-header p {
            color: #6b7a8f;
            font-size: 14px;
            margin: 4px 0 0;
        }

    .confirm-card {
        background: #fff;
        border-radius: 14px;
        border: 1px solid #eaedf2;
        padding: 28px 32px;
        max-width: 560px;
        margin: 0 auto;
    }

    .alert-danger {
        padding: 12px 16px;
        border-radius: 8px;
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
        font-size: 14px;
        margin-bottom: 16px;
    }

    .details-box {
        background: #f8fafc;
        border-radius: 8px;
        padding: 16px 20px;
        margin-bottom: 20px;
    }

        .details-box .row {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            border-bottom: 1px solid #f0f2f7;
            font-size: 14px;
        }

            .details-box .row:last-child {
                border-bottom: none;
            }

            .details-box .row .label {
                color: #6b7a8f;
            }

            .details-box .row .value {
                font-weight: 500;
                color: #0a1628;
            }

    .btn-danger {
        padding: 10px 24px;
        background: #dc2626;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
        text-decoration: none;
        display: inline-block;
    }

        .btn-danger:hover {
            background: #b91c1c;
        }

    .btn-secondary {
        padding: 10px 24px;
        background: #f0f2f7;
        color: #0a1628;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: 0.2s;
        text-decoration: none;
        display: inline-block;
    }

        .btn-secondary:hover {
            background: #e5e8ef;
        }

    @@media (max-width: 600px) {
        .confirm-card {
            padding: 20px;
        }
    }
</style>

<div>

    <!-- Header -->
    <div class="page-header">
        <h1>Delete Beneficiary</h1>
        <p>Remove a saved recipient</p>
    </div>

    <!-- Confirmation -->
    <div class="confirm-card">

        <div class="alert-danger">
            <i class="fas fa-exclamation-circle me-2"></i>
            Are you sure you want to delete this beneficiary? This action cannot be undone.
        </div>

        <div class="details-box">
            <div class="row">
                <span class="label">Name</span>
                <span class="value">@Model.Name</span>
            </div>
            <div class="row">
                <span class="label">Nickname</span>
                <span class="value">@(string.IsNullOrEmpty(Model.Nickname) ? "N/A" : Model.Nickname)</span>
            </div>
            <div class="row">
                <span class="label">Account Number</span>
                <span class="value">@Model.AccountNumber</span>
            </div>
            <div class="row">
                <span class="label">Bank</span>
                <span class="value">@Model.BankName</span>
            </div>
        </div>

        @using (Html.BeginForm("Delete", "Beneficiary", new { id = Model.Id }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)

            <div style="display:flex; gap:12px;">
                <button type="submit" class="btn-danger">
                    <i class="fas fa-trash me-2"></i>Delete Beneficiary
                </button>
                <a href="@Url.Action("Index", "Beneficiary")" class="btn-secondary">Cancel</a>
            </div>
        }

    </div>

</div>