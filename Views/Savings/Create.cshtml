@model StandardBank.ViewModels.CreateSavingsGoalViewModel

@{
    ViewBag.Title = "Create Savings Goal";
    ViewBag.SubTitle = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header {
        margin-bottom: 28px;
    }

        .page-header h1 {
            font-size: 24px;
            font-weight: 700;
            color: #0a1628;
            margin: 0;
        }

        .page-header p {
            color: #6b7a8f;
            font-size: 14px;
            margin: 4px 0 0;
        }

    .form-card {
        background: #fff;
        border-radius: 14px;
        border: 1px solid #eaedf2;
        padding: 28px 32px;
        max-width: 600px;
        margin: 0 auto;
    }

        .form-card .form-group {
            margin-bottom: 18px;
        }

            .form-card .form-group label {
                font-size: 13px;
                font-weight: 600;
                color: #0a1628;
                display: block;
                margin-bottom: 4px;
            }

            .form-card .form-group .form-control {
                width: 100%;
                padding: 10px 14px;
                border: 1px solid #eaedf2;
                border-radius: 8px;
                font-size: 14px;
                font-family: 'Inter', sans-serif;
                transition: 0.2s;
                background: #fff;
                color: #0a1628;
            }

                .form-card .form-group .form-control:focus {
                    border-color: #003399;
                    outline: none;
                    box-shadow: 0 0 0 3px rgba(0,51,153,0.06);
                }

                .form-card .form-group .form-control::placeholder {
                    color: #9aa3b3;
                }

            .form-card .form-group .hint {
                font-size: 12px;
                color: #6b7a8f;
                margin-top: 4px;
            }

        .form-card .amount-input {
            position: relative;
        }

            .form-card .amount-input .currency {
                position: absolute;
                left: 14px;
                top: 50%;
                transform: translateY(-50%);
                font-weight: 600;
                color: #6b7a8f;
                font-size: 15px;
            }

            .form-card .amount-input input {
                padding-left: 32px;
            }

        .form-card .submit-btn {
            width: 100%;
            padding: 12px;
            background: #003399;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
            margin-top: 4px;
        }

            .form-card .submit-btn:hover {
                background: #002266;
            }

    .alert {
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 16px;
        font-size: 14px;
    }

    .alert-info {
        background: #e8f0fe;
        color: #003399;
        border: 1px solid #c5d5f0;
    }

    .alert-danger {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    .text-danger {
        color: #dc2626;
        font-size: 13px;
        margin-top: 4px;
        display: block;
    }

    .btn-secondary {
        padding: 10px 24px;
        background: #f0f2f7;
        color: #0a1628;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: 0.2s;
        text-decoration: none;
        display: inline-block;
    }

        .btn-secondary:hover {
            background: #e5e8ef;
        }

    @@media (max-width: 600px) {
        .form-card {
            padding: 20px;
        }
    }
</style>

<div>

    <!-- Header -->
    <div class="page-header">
        <h1>Create Savings Goal</h1>
        <p>Set a new savings target</p>
    </div>

    <!-- Form -->
    <div class="form-card">

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            </div>
        }

        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            Set a savings goal to track your progress. You can add funds from your accounts anytime.
        </div>

        @using (Html.BeginForm("Create", "Savings", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                @Html.LabelFor(m => m.GoalName, "Goal Name")
                @Html.TextBoxFor(m => m.GoalName, new { @class = "form-control", placeholder = "e.g., New Car, Vacation, Emergency Fund" })
                @Html.ValidationMessageFor(m => m.GoalName, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.TargetAmount, "Target Amount")
                <div class="amount-input">
                    <span class="currency">R</span>
                    @Html.TextBoxFor(m => m.TargetAmount, new { @class = "form-control", placeholder = "0.00", type = "number", step = "0.01" })
                </div>
                @Html.ValidationMessageFor(m => m.TargetAmount, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.CurrentAmount, "Current Amount (Optional)")
                <div class="amount-input">
                    <span class="currency">R</span>
                    @Html.TextBoxFor(m => m.CurrentAmount, new { @class = "form-control", placeholder = "0.00", type = "number", step = "0.01" })
                </div>
                @Html.ValidationMessageFor(m => m.CurrentAmount, "", new { @class = "text-danger" })
                <div class="hint">Initial amount already saved for this goal</div>
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Deadline, "Deadline")
                @Html.TextBoxFor(m => m.Deadline, new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(m => m.Deadline, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Description, "Description")
                @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "2", placeholder = "Description (optional)" })
                @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
            </div>

            <div style="display:flex; gap:12px;">
                <button type="submit" class="submit-btn">
                    <i class="fas fa-save me-2"></i>Create Goal
                </button>
                <a href="@Url.Action("Index", "Savings")" class="btn-secondary">Cancel</a>
            </div>
        }

    </div>

</div>