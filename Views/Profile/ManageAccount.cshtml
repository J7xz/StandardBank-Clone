@model IEnumerable<StandardBank.Models.Account>

@{
    ViewBag.Title = "Manage Accounts";
    ViewBag.SubTitle = "View and manage your bank accounts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="animate-fade-in">
    <!-- Summary -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card card-elegant">
                <div class="card-body">
                    <h6 class="text-muted small">Total Accounts</h6>
                    <h3 class="fw-bold mb-0">@ViewBag.AccountCount</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-elegant">
                <div class="card-body">
                    <h6 class="text-muted small">Total Balance</h6>
                    <h3 class="fw-bold text-success mb-0">@ViewBag.TotalBalance.ToString("C")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-elegant">
                <div class="card-body">
                    <h6 class="text-muted small">Active Accounts</h6>
                    <h3 class="fw-bold mb-0">@Model.Count(a => a.IsActive)</h3>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Account List -->
    <div class="card card-elegant">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="fas fa-wallet me-2"></i>Your Accounts</span>
            <a href="@Url.Action("CreateAccount", "Banking")" class="btn btn-sm btn-primary">
                <i class="fas fa-plus-circle me-2"></i>Open New Account
            </a>
        </div>
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Account Number</th>
                                <th>Name</th>
                                <th>Type</th>
                                <th>Balance</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var account in Model)
                            {
                                <tr>
                                    <td><span class="fw-semibold">@account.AccountNumber</span></td>
                                    <td>@account.AccountName</td>
                                    <td>
                                        <span class="badge bg-@(account.AccountType == "Cheque" ? "primary" : account.AccountType == "Savings" ? "success" : "warning")">
                                            @account.AccountType
                                        </span>
                                    </td>
                                    <td class="fw-bold">@account.Balance.ToString("C")</td>
                                    <td>
                                        <span class="badge @(account.IsActive ? "bg-success" : "bg-danger")">
                                            @(account.IsActive ? "Active" : "Closed")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a href="@Url.Action("AccountDetails", "Banking", new { id = account.Id })" class="btn btn-outline-primary">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            @if (account.IsActive && account.Balance == 0)
                                            {
                                                <a href="@Url.Action("CloseAccount", "Profile", new { id = account.Id })" class="btn btn-outline-danger">
                                                    <i class="fas fa-times"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fas fa-wallet fa-3x text-muted mb-3"></i>
                    <h5>No Accounts Found</h5>
                    <p class="text-muted">You don't have any accounts yet.</p>
                    <a href="@Url.Action("CreateAccount", "Banking")" class="btn btn-primary">
                        <i class="fas fa-plus-circle me-2"></i>Open an Account
                    </a>
                </div>
            }
        </div>
    </div>
</div>