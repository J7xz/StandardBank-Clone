@model StandardBank.Models.Budget

@{
    ViewBag.Title = "Delete Budget";
    ViewBag.SubTitle = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header {
        margin-bottom: 28px;
    }

        .page-header h1 {
            font-size: 24px;
            font-weight: 700;
            color: #0a1628;
            margin: 0;
        }

        .page-header p {
            color: #6b7a8f;
            font-size: 14px;
            margin: 4px 0 0;
        }

    .confirm-card {
        background: #fff;
        border-radius: 14px;
        border: 1px solid #eaedf2;
        padding: 28px 32px;
        max-width: 560px;
        margin: 0 auto;
    }

    .alert-danger {
        padding: 12px 16px;
        border-radius: 8px;
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
        font-size: 14px;
        margin-bottom: 16px;
    }

    .details-box {
        background: #f8fafc;
        border-radius: 8px;
        padding: 16px 20px;
        margin-bottom: 20px;
    }

        .details-box .row {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            border-bottom: 1px solid #f0f2f7;
            font-size: 14px;
        }

            .details-box .row:last-child {
                border-bottom: none;
            }

            .details-box .row .label {
                color: #6b7a8f;
            }

            .details-box .row .value {
                font-weight: 500;
                color: #0a1628;
            }

    .btn-danger {
        padding: 10px 24px;
        background: #dc2626;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
        text-decoration: none;
        display: inline-block;
    }

        .btn-danger:hover {
            background: #b91c1c;
        }

    .btn-secondary {
        padding: 10px 24px;
        background: #f0f2f7;
        color: #0a1628;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: 0.2s;
        text-decoration: none;
        display: inline-block;
    }

        .btn-secondary:hover {
            background: #e5e8ef;
        }

    .status-badge {
        font-size: 11px;
        font-weight: 600;
        padding: 2px 12px;
        border-radius: 20px;
    }

        .status-badge.completed {
            background: #dcfce7;
            color: #166534;
        }

        .status-badge.inprogress {
            background: #e8f0fe;
            color: #003399;
        }

    @@media (max-width: 600px) {
        .confirm-card {
            padding: 20px;
        }
    }
</style>

<div>

    <!-- Header -->
    <div class="page-header">
        <h1>Delete Budget</h1>
        <p>Remove a budget</p>
    </div>

    <!-- Confirmation -->
    <div class="confirm-card">

        <div class="alert-danger">
            <i class="fas fa-exclamation-circle me-2"></i>
            Are you sure you want to delete this budget? This action cannot be undone.
        </div>

        <div class="details-box">
            <div class="row">
                <span class="label">Category</span>
                <span class="value">@Model.Category</span>
            </div>
            <div class="row">
                <span class="label">Allocated</span>
                <span class="value">@Model.AllocatedAmount.ToString("C")</span>
            </div>
            <div class="row">
                <span class="label">Spent</span>
                <span class="value" style="color:#dc2626;">@Model.SpentAmount.ToString("C")</span>
            </div>
            <div class="row">
                <span class="label">Remaining</span>
                <span class="value" style="color:#16a34a;">@Model.RemainingAmount.ToString("C")</span>
            </div>
            <div class="row">
                <span class="label">Month</span>
                <span class="value">@(new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy"))</span>
            </div>
            <div class="row">
                <span class="label">Usage</span>
                <span class="value">
                    <span class="status-badge @(Model.SpentPercentage > 100 ? "over" : Model.SpentPercentage >= 80 ? "near" : "ontrack")">
                        @Model.SpentPercentage.ToString("F0")%
                    </span>
                </span>
            </div>
        </div>

        @using (Html.BeginForm("Delete", "Budget", new { id = Model.Id }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div style="display:flex; gap:12px;">
                <button type="submit" class="btn-danger">
                    <i class="fas fa-trash me-2"></i>Delete Budget
                </button>
                <a href="@Url.Action("Index", "Budget")" class="btn-secondary">Cancel</a>
            </div>
        }

    </div>

</div>