@model StandardBank.ViewModels.DepositViewModel

@{
    ViewBag.Title = "Deposit";
    ViewBag.SubTitle = "Add funds to your account";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center animate-fade-in">
    <div class="col-lg-6">
        <div class="card card-elegant">
            <div class="card-header">
                <i class="fas fa-arrow-down me-2"></i>Deposit Funds
            </div>
            <div class="card-body p-4">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    This is a simulation. In a real banking app, you would be redirected to a payment gateway.
                </div>

                @using (Html.BeginForm("Deposit", "Banking", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.AccountId, new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.AccountId,
                            new SelectList(Model.Accounts, "Id", "AccountNumberWithBalance"),
                            "-- Select Account --",
                            new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.AccountId, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Amount, new { @class = "form-label" })
                        <div class="input-group">
                            <span class="input-group-text">R</span>
                            @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", placeholder = "0.00", type = "number", step = "0.01" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Amount, "", new { @class = "text-danger small" })
                        <div class="mt-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setAmount(100)">R100</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setAmount(500)">R500</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setAmount(1000)">R1,000</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setAmount(5000)">R5,000</button>
                        </div>
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Reference, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Reference, new { @class = "form-control", placeholder = "Reference (optional)" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Description, new { @class = "form-label" })
                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "2", placeholder = "Description (optional)" })
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2">
                        <i class="fas fa-arrow-down me-2"></i>Deposit Funds
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function setAmount(amount) {
            document.getElementById('Amount').value = amount;
        }
    </script>
}