<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Standard Bank</title>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" />

    @Styles.Render("~/Content/css")

    @RenderSection("Styles", required: false)
</head>
<body>

    <!-- Simple Header without Sidebar -->
    <header style="background: #fff; border-bottom: 1px solid #eaedf2; padding: 12px 0; position: sticky; top:0; z-index:100;">
        <div class="container">
            <nav class="navbar navbar-expand-lg" style="background: transparent; padding: 0;">
                <a href="@Url.Action("Index", "Home")" class="navbar-brand d-flex align-items-center">
                    <div style="width: 38px; height: 38px; border-radius: 8px; background: #003399; display: flex; align-items: center; justify-content: center; margin-right: 10px;">
                        <span style="font-size: 14px; font-weight: 800; color: #fff;">J7</span>
                    </div>
                    <div>
                        <span style="font-weight: 700; color: #0a1628; font-size: 16px; letter-spacing: 0.5px;">STANDARD</span>
                        <span style="font-weight: 300; color: #6b7a8f; font-size: 11px; letter-spacing: 2px; margin-left: 2px;">BANK</span>
                    </div>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                        @if (!User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a href="@Url.Action("Index", "Home")" class="nav-link" style="color: #0a1628; font-weight: 500;">Home</a>
                            </li>
                            <li class="nav-item">
                                <a href="@Url.Action("About", "Home")" class="nav-link" style="color: #0a1628; font-weight: 500;">About</a>
                            </li>
                            <li class="nav-item">
                                <a href="@Url.Action("Contact", "Home")" class="nav-link" style="color: #0a1628; font-weight: 500;">Contact</a>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <a href="@Url.Action("Login", "Account")" class="btn btn-outline-primary" style="border-radius: 8px; padding: 8px 24px; font-weight: 600; border-color: #003399; color: #003399;">
                                    Sign In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="@Url.Action("Register", "Account")" class="btn btn-primary" style="border-radius: 8px; padding: 8px 24px; font-weight: 600; background: #003399; border: none;">
                                    Get Started
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a href="@Url.Action("Index", "Dashboard")" class="btn btn-primary" style="border-radius: 8px; padding: 8px 24px; font-weight: 600; background: #003399; border: none;">
                                    <i class="fas fa-th-large me-2"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="@Url.Action("Logout", "Account")" class="btn btn-outline-danger" style="border-radius: 8px; padding: 8px 24px; font-weight: 600;">
                                    <i class="fas fa-sign-out-alt me-2"></i>Logout
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </nav>
        </div>
    </header>

    <!-- Page Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer style="background: #0a1628; color: rgba(255,255,255,0.5); padding: 40px 0; margin-top: 40px;">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3 mb-md-0">
                    <h6 style="color: #fff; font-weight: 700;">Standard Bank</h6>
                    <p style="font-size: 13px; color: rgba(255,255,255,0.3); max-width: 280px;">Banking made simple and secure. Managing your finances has never been easier.</p>
                </div>
                <div class="col-md-2 mb-3 mb-md-0">
                    <h6 style="color: #fff; font-weight: 600; font-size: 13px;">Product</h6>
                    <ul class="list-unstyled" style="font-size: 13px;">
                        <li><a href="@Url.Action("Index", "Home")" style="color: rgba(255,255,255,0.3); text-decoration: none;">Home</a></li>
                        <li><a href="@Url.Action("About", "Home")" style="color: rgba(255,255,255,0.3); text-decoration: none;">About</a></li>
                    </ul>
                </div>
                <div class="col-md-2 mb-3 mb-md-0">
                    <h6 style="color: #fff; font-weight: 600; font-size: 13px;">Company</h6>
                    <ul class="list-unstyled" style="font-size: 13px;">
                        <li><a href="@Url.Action("About", "Home")" style="color: rgba(255,255,255,0.3); text-decoration: none;">About</a></li>
                        <li><a href="@Url.Action("Contact", "Home")" style="color: rgba(255,255,255,0.3); text-decoration: none;">Contact</a></li>
                    </ul>
                </div>
                <div class="col-md-2">
                    <h6 style="color: #fff; font-weight: 600; font-size: 13px;">Legal</h6>
                    <ul class="list-unstyled" style="font-size: 13px;">
                        <li><a href="@Url.Action("Privacy", "Home")" style="color: rgba(255,255,255,0.3); text-decoration: none;">Privacy</a></li>
                        <li><a href="@Url.Action("Terms", "Home")" style="color: rgba(255,255,255,0.3); text-decoration: none;">Terms</a></li>
                    </ul>
                </div>
            </div>
            <hr style="border-color: rgba(255,255,255,0.05); margin: 20px 0;" />
            <div style="text-align: center; font-size: 12px; color: rgba(255,255,255,0.2);">
                &copy; @DateTime.Now.Year Standard Bank. All rights reserved.
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>