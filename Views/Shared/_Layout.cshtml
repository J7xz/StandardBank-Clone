<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Standard Bank</title>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" />

    @Styles.Render("~/Content/css")

    <style>
        /* ===== ROOT VARIABLES ===== */
        :root {
            --primary: #0a1628;
            --primary-light: #1a2a4a;
            --primary-dark: #050d1a;
            --secondary: #4a6cf7;
            --accent: #ffd54f;
            --sidebar-width: 260px;
            --header-height: 64px;
            --bg-light: #f0f2f5;
            --card-shadow: 0 2px 16px rgba(10, 22, 40, 0.08);
            --card-hover-shadow: 0 8px 40px rgba(10, 22, 40, 0.14);
            --radius: 12px;
            --transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            --text-primary: #0a1628;
            --text-secondary: #64748b;
            --border-color: #e8edf2;
        }

        /* ===== RESET ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg-light);
            color: var(--text-primary);
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
        }

            a:hover {
                text-decoration: none;
            }

        /* ===== SCROLLBAR ===== */
        ::-webkit-scrollbar {
            width: 4px;
            height: 4px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(10, 22, 40, 0.15);
            border-radius: 10px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: rgba(10, 22, 40, 0.25);
            }

        /* ===== SIDEBAR ===== */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background: linear-gradient(180deg, var(--primary-dark) 0%, var(--primary) 60%, var(--primary-light) 100%);
            z-index: 1050;
            transition: var(--transition);
            box-shadow: 4px 0 30px rgba(10, 22, 40, 0.2);
            overflow-y: auto;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
        }

            .sidebar::-webkit-scrollbar {
                width: 3px;
            }

            .sidebar::-webkit-scrollbar-thumb {
                background: rgba(255, 255, 255, 0.15);
                border-radius: 10px;
            }

        /* Sidebar Brand */
        .sidebar-brand {
            padding: 18px 20px 14px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
            flex-shrink: 0;
        }

            .sidebar-brand .brand-link {
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
            }

                .sidebar-brand .brand-link:hover {
                    text-decoration: none;
                }

            .sidebar-brand .brand-icon {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: rgba(255, 255, 255, 0.08);
                border: 1.5px solid rgba(255, 255, 255, 0.08);
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                position: relative;
                font-size: 16px;
                font-weight: 800;
                color: #fff;
                letter-spacing: -0.5px;
            }

                .sidebar-brand .brand-icon .dot {
                    position: absolute;
                    bottom: -2px;
                    right: -2px;
                    width: 10px;
                    height: 10px;
                    background: var(--accent);
                    border-radius: 50%;
                    border: 2px solid var(--primary);
                }

            .sidebar-brand .brand-text .name {
                font-size: 15px;
                font-weight: 700;
                color: #fff;
                letter-spacing: 0.3px;
            }

            .sidebar-brand .brand-text .sub {
                font-size: 9px;
                font-weight: 400;
                color: rgba(255, 255, 255, 0.3);
                letter-spacing: 2.5px;
                text-transform: uppercase;
                margin-top: 1px;
            }

        /* Sidebar Navigation */
        .sidebar-nav {
            flex: 1;
            padding: 16px 14px 20px;
        }

            .sidebar-nav .nav-label {
                font-size: 10px;
                font-weight: 600;
                color: rgba(255, 255, 255, 0.2);
                text-transform: uppercase;
                letter-spacing: 1.2px;
                padding: 10px 14px 6px;
            }

            .sidebar-nav .nav-item {
                margin-bottom: 1px;
            }

            .sidebar-nav .nav-link {
                display: flex;
                align-items: center;
                padding: 9px 14px;
                border-radius: 8px;
                color: rgba(255, 255, 255, 0.5);
                font-size: 13.5px;
                font-weight: 500;
                transition: var(--transition);
                gap: 12px;
                position: relative;
            }

                .sidebar-nav .nav-link:hover {
                    color: #fff;
                    background: rgba(255, 255, 255, 0.06);
                }

                .sidebar-nav .nav-link.active {
                    color: #fff;
                    background: rgba(255, 255, 255, 0.08);
                }

                    .sidebar-nav .nav-link.active::before {
                        content: '';
                        position: absolute;
                        left: 0;
                        top: 50%;
                        transform: translateY(-50%);
                        width: 3px;
                        height: 20px;
                        background: var(--accent);
                        border-radius: 0 4px 4px 0;
                    }

                .sidebar-nav .nav-link i {
                    width: 18px;
                    font-size: 14px;
                    text-align: center;
                    color: rgba(255, 255, 255, 0.3);
                    flex-shrink: 0;
                }

                .sidebar-nav .nav-link:hover i,
                .sidebar-nav .nav-link.active i {
                    color: #fff;
                }

                .sidebar-nav .nav-link .badge {
                    margin-left: auto;
                    background: var(--accent);
                    color: var(--primary);
                    font-size: 9px;
                    font-weight: 700;
                    padding: 1px 8px;
                    border-radius: 12px;
                }

        /* Sidebar Footer */
        .sidebar-footer {
            padding: 14px 20px 18px;
            border-top: 1px solid rgba(255, 255, 255, 0.04);
            flex-shrink: 0;
        }

            .sidebar-footer .user-card {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .sidebar-footer .user-avatar {
                width: 36px;
                height: 36px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.06);
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-weight: 600;
                font-size: 14px;
                border: 1.5px solid rgba(255, 255, 255, 0.06);
                flex-shrink: 0;
            }

            .sidebar-footer .user-info {
                flex: 1;
                min-width: 0;
            }

            .sidebar-footer .user-name {
                font-size: 13px;
                font-weight: 600;
                color: #fff;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .sidebar-footer .user-email {
                font-size: 10px;
                color: rgba(255, 255, 255, 0.3);
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .sidebar-footer .logout-btn {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                border: none;
                background: rgba(255, 255, 255, 0.04);
                color: rgba(255, 255, 255, 0.3);
                cursor: pointer;
                transition: var(--transition);
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

                .sidebar-footer .logout-btn:hover {
                    background: rgba(255, 255, 255, 0.08);
                    color: #fff;
                }

        /* ===== MAIN CONTENT ===== */
        .main-content {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ===== HEADER ===== */
        .top-header {
            height: var(--header-height);
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-color);
            padding: 0 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 1040;
        }

            .top-header .header-left {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .top-header .toggle-sidebar {
                display: none;
                background: none;
                border: none;
                font-size: 18px;
                color: var(--text-primary);
                cursor: pointer;
                padding: 4px;
            }

            .top-header .page-title {
                font-size: 16px;
                font-weight: 700;
                color: var(--text-primary);
            }

                .top-header .page-title small {
                    font-weight: 400;
                    font-size: 12px;
                    color: var(--text-secondary);
                    margin-left: 6px;
                }

            .top-header .header-right {
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .top-header .header-right .search-box {
                    position: relative;
                }

                    .top-header .header-right .search-box input {
                        padding: 7px 14px 7px 34px;
                        border: 1px solid var(--border-color);
                        border-radius: 8px;
                        font-size: 12.5px;
                        background: #f8fafc;
                        width: 180px;
                        transition: var(--transition);
                        outline: none;
                        font-family: 'Inter', sans-serif;
                        color: var(--text-primary);
                    }

                        .top-header .header-right .search-box input:focus {
                            border-color: var(--secondary);
                            background: #fff;
                            width: 240px;
                            box-shadow: 0 0 0 3px rgba(74, 108, 247, 0.08);
                        }

                    .top-header .header-right .search-box i {
                        position: absolute;
                        left: 11px;
                        top: 50%;
                        transform: translateY(-50%);
                        color: var(--text-secondary);
                        font-size: 13px;
                    }

                .top-header .header-right .icon-btn {
                    width: 38px;
                    height: 38px;
                    border-radius: 50%;
                    border: none;
                    background: transparent;
                    color: var(--text-secondary);
                    cursor: pointer;
                    transition: var(--transition);
                    position: relative;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                }

                    .top-header .header-right .icon-btn:hover {
                        background: #f1f4f9;
                        color: var(--text-primary);
                    }

                    .top-header .header-right .icon-btn .notif-dot {
                        position: absolute;
                        top: 7px;
                        right: 7px;
                        width: 7px;
                        height: 7px;
                        background: #ef4444;
                        border-radius: 50%;
                        border: 2px solid #fff;
                    }

        /* ===== PAGE CONTENT ===== */
        .page-content {
            flex: 1;
            padding: 28px 32px 32px;
        }

        /* ===== RESPONSIVE ===== */
        @@media (max-width: 992px) {
            .sidebar {
                transform: translateX(-100%);
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .main-content {
                margin-left: 0;
            }

            .top-header .toggle-sidebar {
                display: block;
            }

            .top-header .header-right .search-box input {
                width: 120px;
            }

                .top-header .header-right .search-box input:focus {
                    width: 160px;
                }

            .page-content {
                padding: 20px 16px 24px;
            }
        }

        @@media (max-width: 576px) {
            .top-header {
                padding: 0 14px;
            }

                .top-header .page-title {
                    font-size: 14px;
                }

                    .top-header .page-title small {
                        display: none;
                    }

                .top-header .header-right .search-box input {
                    width: 80px;
                }

                    .top-header .header-right .search-box input:focus {
                        width: 120px;
                    }

                .top-header .header-right .icon-btn {
                    width: 34px;
                    height: 34px;
                    font-size: 13px;
                }

            .page-content {
                padding: 14px 10px 18px;
            }
        }

        /* ===== SIDEBAR OVERLAY ===== */
        .sidebar-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.35);
            z-index: 1045;
            display: none;
            backdrop-filter: blur(3px);
            -webkit-backdrop-filter: blur(3px);
        }

            .sidebar-overlay.show {
                display: block;
            }

        /* ===== CARDS ===== */
        .card-elegant {
            background: #fff;
            border: none;
            border-radius: var(--radius);
            box-shadow: var(--card-shadow);
            transition: var(--transition);
            overflow: hidden;
        }

            .card-elegant:hover {
                box-shadow: var(--card-hover-shadow);
            }

            .card-elegant .card-header {
                background: transparent;
                border-bottom: 1px solid var(--border-color);
                padding: 14px 20px;
                font-weight: 600;
                font-size: 14px;
                color: var(--text-primary);
            }

            .card-elegant .card-body {
                padding: 20px;
            }

        /* ===== ANIMATIONS ===== */
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(16px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-fade-in {
            animation: fadeInUp 0.4s ease forwards;
        }

        .animate-delay-1 {
            animation-delay: 0.08s;
        }

        .animate-delay-2 {
            animation-delay: 0.16s;
        }

        .animate-delay-3 {
            animation-delay: 0.24s;
        }

        /* ===== UTILITY ===== */
        .stat-icon {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .text-secondary-custom {
            color: var(--text-secondary);
        }
    </style>

    @RenderSection("Styles", required: false)
</head>

<body>

    <!-- Sidebar Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- ===== SIDEBAR ===== -->
    <aside class="sidebar" id="sidebar">

        <!-- Brand -->
        <div class="sidebar-brand">
            <a href="@Url.Action("Index", "Dashboard")" class="brand-link">
                <div class="brand-icon">
                    J7
                    <span class="dot"></span>
                </div>
                <div class="brand-text">
                    <div class="name">STANDARD</div>
                    <div class="sub">Bank</div>
                </div>
            </a>
        </div>

        <!-- Navigation -->
        <nav class="sidebar-nav">

            @if (!User.IsInRole("Admin"))
            {
                <!-- ===== CUSTOMER MENU ===== -->
                <div class="nav-label">Main</div>

                <div class="nav-item">
                    <a href="@Url.Action("Index", "Dashboard")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Dashboard" ? "active" : "")">
                        <i class="fas fa-th-large"></i>
                        <span>Dashboard</span>
                    </a>
                </div>

                <div class="nav-item">
                    <a href="@Url.Action("Index", "Banking")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Banking" ? "active" : "")">
                        <i class="fas fa-exchange-alt"></i>
                        <span>Banking</span>
                    </a>
                </div>

                <div class="nav-item">
                    <a href="@Url.Action("PayBill", "BillPayment")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "BillPayment" ? "active" : "")">
                        <i class="fas fa-file-invoice"></i>
                        <span>Pay Bills</span>
                    </a>
                </div>

                <div class="nav-item">
                    <a href="@Url.Action("Index", "Beneficiary")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Beneficiary" ? "active" : "")">
                        <i class="fas fa-users"></i>
                        <span>Beneficiaries</span>
                    </a>
                </div>

                <div class="nav-label mt-2">Planning</div>

                <div class="nav-item">
                    <a href="@Url.Action("Index", "Savings")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Savings" ? "active" : "")">
                        <i class="fas fa-piggy-bank"></i>
                        <span>Savings Goals</span>
                    </a>
                </div>

                <div class="nav-item">
                    <a href="@Url.Action("Index", "Budget")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Budget" ? "active" : "")">
                        <i class="fas fa-chart-pie"></i>
                        <span>Budget</span>
                        <span class="badge">AI</span>
                    </a>
                </div>

                <div class="nav-label mt-2">Account</div>

                <div class="nav-item">
                    <a href="@Url.Action("Index", "Profile")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Profile" ? "active" : "")">
                        <i class="fas fa-user-cog"></i>
                        <span>Profile</span>
                    </a>
                </div>

                <div class="nav-item">
                    <a href="@Url.Action("Index", "Notification")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Notification" ? "active" : "")">
                        <i class="fas fa-bell"></i>
                        <span>Notifications</span>
                        @if (ViewBag.UnreadCount != null && ViewBag.UnreadCount > 0)
                        {
                            <span class="badge">@ViewBag.UnreadCount</span>
                        }
                    </a>
                </div>
            }

            @if (User.IsInRole("Admin"))
            {
                <!-- ===== ADMIN MENU ===== -->
                <div class="nav-label">Admin</div>

                <div class="nav-item">
                    <a href="@Url.Action("Index", "Admin")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Admin" && ViewContext.RouteData.Values["action"].ToString() == "Index" ? "active" : "")">
                        <i class="fas fa-th-large"></i>
                        <span>Dashboard</span>
                    </a>
                </div>

                <div class="nav-item">
                    <a href="@Url.Action("Users", "Admin")" class="nav-link @(ViewContext.RouteData.Values["action"].ToString() == "Users" ? "active" : "")">
                        <i class="fas fa-users-cog"></i>
                        <span>User Management</span>
                    </a>
                </div>

                <div class="nav-item">
                    <a href="@Url.Action("Transactions", "Admin")" class="nav-link @(ViewContext.RouteData.Values["action"].ToString() == "Transactions" ? "active" : "")">
                        <i class="fas fa-exchange-alt"></i>
                        <span>Transactions</span>
                    </a>
                </div>

                <div class="nav-item">
                    <a href="@Url.Action("Logs", "Admin")" class="nav-link @(ViewContext.RouteData.Values["action"].ToString() == "Logs" ? "active" : "")">
                        <i class="fas fa-history"></i>
                        <span>Logs</span>
                    </a>
                </div>

                <div class="nav-item">
                    <a href="@Url.Action("Reports", "Admin")" class="nav-link @(ViewContext.RouteData.Values["action"].ToString() == "Reports" ? "active" : "")">
                        <i class="fas fa-file-alt"></i>
                        <span>Reports</span>
                    </a>
                </div>

                <div class="nav-label mt-2">Account</div>

                <div class="nav-item">
                    <a href="@Url.Action("Index", "Profile")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Profile" ? "active" : "")">
                        <i class="fas fa-user-cog"></i>
                        <span>Profile</span>
                    </a>
                </div>
            }

        </nav>

        <!-- Sidebar Footer -->
        <div class="sidebar-footer">
            <div class="user-card">
                <div class="user-avatar">
                    @if (User.Identity.IsAuthenticated)
                    {
                        var name = User.Identity.Name;
                        <span>@(name?.Substring(0, 1).ToUpper() ?? "U")</span>
                    }
                    else
                    {
                        <span>U</span>
                    }
                </div>
                <div class="user-info">
                    <div class="user-name">
                        @if (User.Identity.IsAuthenticated)
                        {
                            @User.Identity.Name
                        }
                        else
                        {
                            <span>Guest</span>
                        }
                    </div>
                    <div class="user-email">
                        @if (User.Identity.IsAuthenticated)
                        {
                            @User.Identity.Name
                        }
                        else
                        {
                            <span>Not logged in</span>
                        }
                    </div>
                </div>
                @if (User.Identity.IsAuthenticated)
                {
                    using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="logout-btn" title="Logout">
                            <i class="fas fa-sign-out-alt"></i>
                        </button>
                    }
                }
            </div>
        </div>
    </aside>

    <!-- ===== MAIN CONTENT ===== -->
    <div class="main-content">

        <!-- Top Header -->
        <header class="top-header">
            <div class="header-left">
                <button class="toggle-sidebar" id="toggleSidebar" aria-label="Toggle Sidebar">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="page-title">
                    @ViewBag.Title
                    <small>@ViewBag.SubTitle</small>
                </div>
            </div>
            <div class="header-right">
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Search..." id="globalSearch" />
                </div>
                <button class="icon-btn" title="Notifications" onclick="location.href='@Url.Action("Index", "Notification")'">
                    <i class="fas fa-bell"></i>
                    @if (ViewBag.UnreadCount != null && ViewBag.UnreadCount > 0)
                    {
                        <span class="notif-dot"></span>
                    }
                </button>
                <button class="icon-btn" title="Profile" onclick="location.href='@Url.Action("Index", "Profile")'">
                    <i class="fas fa-user"></i>
                </button>
            </div>
        </header>

        <!-- Page Content -->
        <main class="page-content">
            @RenderBody()
        </main>

    </div>

    <!-- ===== SCRIPTS ===== -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // ===== SIDEBAR TOGGLE =====
        var sidebar = document.getElementById('sidebar');
        var overlay = document.getElementById('sidebarOverlay');
        var toggleBtn = document.getElementById('toggleSidebar');

        function toggleSidebarFn() {
            sidebar.classList.toggle('open');
            overlay.classList.toggle('show');
        }

        if (toggleBtn) toggleBtn.addEventListener('click', toggleSidebarFn);
        if (overlay) overlay.addEventListener('click', toggleSidebarFn);

        window.addEventListener('resize', function() {
            if (window.innerWidth > 992) {
                sidebar.classList.remove('open');
                overlay.classList.remove('show');
            }
        });

        // ===== GLOBAL SEARCH =====
        document.getElementById('globalSearch')?.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                var term = this.value.trim();
                if (term.length > 0) {
                    window.location.href = '@Url.Action("Index", "Banking")?searchTerm=' + encodeURIComponent(term);
                }
            }
        });

        // ===== UNREAD NOTIFICATION COUNT =====
        function updateUnreadCount() {
            fetch('@Url.Action("GetUnreadCount", "Notification")')
                .then(function(response) { return response.json(); })
                .then(function(data) {
                    var dot = document.querySelector('.notif-dot');
                    var badge = document.querySelector('.nav-link .badge');
                    if (data.count > 0) {
                        if (dot) dot.style.display = 'block';
                        if (badge) {
                            badge.textContent = data.count;
                            badge.style.display = 'inline';
                        }
                    } else {
                        if (dot) dot.style.display = 'none';
                        if (badge) badge.style.display = 'none';
                    }
                })
                .catch(function() {});
        }
        setInterval(updateUnreadCount, 30000);
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>