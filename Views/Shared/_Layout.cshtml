<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Standard Bank</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #003399;
            --primary-dark: #002266;
            --primary-light: #1a4cb3;
            --gold: #c9a84c;
            --gold-light: #f5e6b8;
            --bg: #f0f2f7;
            --card: #ffffff;
            --text: #0a1628;
            --text-light: #6b7a8f;
            --border: #eaedf2;
            --shadow: 0 2px 12px rgba(0,0,0,0.04);
            --radius: 16px;
            --sidebar: 240px;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.5;
        }

        /* ===== SIDEBAR ===== */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: var(--sidebar);
            height: 100vh;
            background: var(--primary-dark);
            z-index: 1000;
            display: flex;
            flex-direction: column;
            padding: 0;
            overflow-y: auto;
        }

            .sidebar::-webkit-scrollbar {
                width: 3px;
            }

            .sidebar::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,0.1);
                border-radius: 10px;
            }

        /* Brand */
        .sidebar-brand {
            padding: 24px 20px 20px;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            flex-shrink: 0;
        }

            .sidebar-brand a {
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
            }

            .sidebar-brand .logo {
                width: 40px;
                height: 40px;
                border-radius: 10px;
                background: rgba(255,255,255,0.06);
                border: 1px solid rgba(255,255,255,0.06);
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 800;
                font-size: 15px;
                color: #fff;
                position: relative;
            }

                .sidebar-brand .logo .dot {
                    position: absolute;
                    bottom: -2px;
                    right: -2px;
                    width: 10px;
                    height: 10px;
                    background: var(--gold);
                    border-radius: 50%;
                    border: 2px solid var(--primary-dark);
                }

            .sidebar-brand .brand .name {
                font-weight: 700;
                font-size: 15px;
                color: #fff;
                letter-spacing: 0.5px;
            }

            .sidebar-brand .brand .sub {
                font-size: 9px;
                font-weight: 400;
                color: rgba(255,255,255,0.2);
                letter-spacing: 2px;
                text-transform: uppercase;
                margin-top: 1px;
            }

        /* Navigation */
        .sidebar-nav {
            flex: 1;
            padding: 20px 14px 20px;
        }

            .sidebar-nav .label {
                font-size: 10px;
                font-weight: 600;
                color: rgba(255,255,255,0.15);
                text-transform: uppercase;
                letter-spacing: 1.2px;
                padding: 4px 12px 8px;
            }

            .sidebar-nav a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 10px 14px;
                border-radius: 10px;
                color: rgba(255,255,255,0.35);
                font-size: 14px;
                font-weight: 500;
                text-decoration: none;
                transition: 0.2s;
                position: relative;
            }

                .sidebar-nav a:hover {
                    color: #fff;
                    background: rgba(255,255,255,0.04);
                }

                .sidebar-nav a.active {
                    color: #fff;
                    background: rgba(255,255,255,0.06);
                }

                    .sidebar-nav a.active::before {
                        content: '';
                        position: absolute;
                        left: 0;
                        top: 50%;
                        transform: translateY(-50%);
                        width: 3px;
                        height: 20px;
                        background: var(--gold);
                        border-radius: 0 4px 4px 0;
                    }

                .sidebar-nav a i {
                    width: 20px;
                    font-size: 15px;
                    text-align: center;
                    color: rgba(255,255,255,0.2);
                }

                .sidebar-nav a:hover i {
                    color: #fff;
                }

                .sidebar-nav a .badge {
                    margin-left: auto;
                    background: var(--gold);
                    color: var(--primary-dark);
                    font-size: 10px;
                    font-weight: 700;
                    padding: 1px 10px;
                    border-radius: 12px;
                }

        /* Sidebar Footer */
        .sidebar-footer {
            padding: 16px 20px 24px;
            border-top: 1px solid rgba(255,255,255,0.04);
            flex-shrink: 0;
        }

            .sidebar-footer .user {
                display: flex;
                align-items: center;
                gap: 12px;
            }

                .sidebar-footer .user .avatar {
                    width: 36px;
                    height: 36px;
                    border-radius: 50%;
                    background: rgba(255,255,255,0.06);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: #fff;
                    font-weight: 600;
                    font-size: 14px;
                    border: 1px solid rgba(255,255,255,0.06);
                    flex-shrink: 0;
                }

                .sidebar-footer .user .info .name {
                    font-size: 13px;
                    font-weight: 600;
                    color: #fff;
                }

                .sidebar-footer .user .info .email {
                    font-size: 11px;
                    color: rgba(255,255,255,0.2);
                }

                .sidebar-footer .user .logout {
                    width: 30px;
                    height: 30px;
                    border-radius: 50%;
                    border: none;
                    background: rgba(255,255,255,0.04);
                    color: rgba(255,255,255,0.2);
                    cursor: pointer;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    transition: 0.2s;
                }

                    .sidebar-footer .user .logout:hover {
                        background: rgba(255,255,255,0.08);
                        color: #fff;
                    }

        /* ===== MAIN CONTENT ===== */
        .main {
            margin-left: var(--sidebar);
            min-height: 100vh;
        }

        /* ===== HEADER ===== */
        .header {
            height: 64px;
            background: rgba(255,255,255,0.92);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border);
            padding: 0 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
        }

            .header .left {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .header .toggle {
                display: none;
                background: none;
                border: none;
                font-size: 20px;
                color: var(--text);
                cursor: pointer;
                padding: 4px;
            }

            .header .title {
                font-size: 16px;
                font-weight: 700;
                color: var(--text);
            }

                .header .title small {
                    font-weight: 400;
                    font-size: 13px;
                    color: var(--text-light);
                    margin-left: 6px;
                }

            .header .right {
                display: flex;
                align-items: center;
                gap: 4px;
            }

                .header .right button {
                    width: 38px;
                    height: 38px;
                    border-radius: 50%;
                    border: none;
                    background: transparent;
                    color: var(--text-light);
                    cursor: pointer;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    position: relative;
                    font-size: 16px;
                    transition: 0.2s;
                }

                    .header .right button:hover {
                        background: #f1f4f9;
                        color: var(--text);
                    }

                    .header .right button .dot {
                        position: absolute;
                        top: 7px;
                        right: 7px;
                        width: 7px;
                        height: 7px;
                        background: #ef4444;
                        border-radius: 50%;
                        border: 2px solid #fff;
                    }

        /* ===== CONTENT ===== */
        .content {
            padding: 32px;
            max-width: 1400px;
            margin: 0 auto;
        }

        /* ===== RESPONSIVE ===== */
        @@media (max-width: 992px) {
            .sidebar {
                transform: translateX(-100%);
                transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .main {
                margin-left: 0;
            }

            .header .toggle {
                display: block;
            }

            .content {
                padding: 24px 16px;
            }
        }

        @@media (max-width: 576px) {
            .header {
                padding: 0 16px;
            }

                .header .title {
                    font-size: 14px;
                }

                    .header .title small {
                        display: none;
                    }

            .content {
                padding: 16px 12px;
            }
        }

        .overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.3);
            z-index: 999;
            display: none;
            backdrop-filter: blur(4px);
        }

            .overlay.show {
                display: block;
            }

        /* ===== UTILITY ===== */
        .card {
            background: var(--card);
            border-radius: var(--radius);
            border: 1px solid var(--border);
            overflow: hidden;
            transition: 0.2s;
        }

            .card:hover {
                border-color: var(--primary-light);
            }

            .card .head {
                padding: 16px 20px;
                border-bottom: 1px solid var(--border);
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

                .card .head .title {
                    font-size: 14px;
                    font-weight: 600;
                    color: var(--text);
                }

                    .card .head .title i {
                        color: var(--primary);
                        margin-right: 8px;
                    }

                .card .head a {
                    font-size: 13px;
                    color: var(--primary);
                    font-weight: 500;
                    text-decoration: none;
                }

                    .card .head a:hover {
                        text-decoration: underline;
                    }

            .card .body {
                padding: 4px 20px 16px;
            }

        .empty {
            padding: 32px 0;
            text-align: center;
            color: var(--text-light);
        }

            .empty i {
                font-size: 32px;
                opacity: 0.15;
                display: block;
                margin-bottom: 10px;
            }

            .empty .main {
                font-size: 14px;
                font-weight: 500;
            }

            .empty .sub {
                font-size: 13px;
            }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1.8fr;
            gap: 24px;
        }

        .grid-2-eq {
            grid-template-columns: 1fr 1fr;
        }

        .grid-3 {
            grid-template-columns: repeat(3, 1fr);
        }

        .grid-4 {
            grid-template-columns: repeat(4, 1fr);
        }

        @@media (max-width: 1024px) {
            .grid-2 {
                grid-template-columns: 1fr;
            }

            .grid-2-eq {
                grid-template-columns: 1fr;
            }

            .grid-3 {
                grid-template-columns: 1fr 1fr;
            }

            .grid-4 {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 600px) {
            .grid-3 {
                grid-template-columns: 1fr;
            }

            .grid-4 {
                grid-template-columns: 1fr 1fr;
            }
        }
    </style>

    @RenderSection("Styles", required: false)
</head>

<body>

    <div class="overlay" id="overlay"></div>

    <!-- ===== SIDEBAR ===== -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <a href="@Url.Action("Index", "Dashboard")">
                <div class="logo">
                    J7
                    <span class="dot"></span>
                </div>
                <div class="brand">
                    <div class="name">STANDARD</div>
                    <div class="sub">Bank</div>
                </div>
            </a>
        </div>

        <nav class="sidebar-nav">
            <div class="label">Main</div>
            <a href="@Url.Action("Index", "Dashboard")" class="@(ViewContext.RouteData.Values["controller"].ToString() == "Dashboard" ? "active" : "")">
                <i class="fas fa-th-large"></i> Dashboard
            </a>
            <a href="@Url.Action("Index", "Banking")" class="@(ViewContext.RouteData.Values["controller"].ToString() == "Banking" ? "active" : "")">
                <i class="fas fa-exchange-alt"></i> Banking
            </a>
            <a href="@Url.Action("PayBill", "BillPayment")" class="@(ViewContext.RouteData.Values["controller"].ToString() == "BillPayment" ? "active" : "")">
                <i class="fas fa-file-invoice"></i> Pay Bills
            </a>
            <a href="@Url.Action("Index", "Beneficiary")" class="@(ViewContext.RouteData.Values["controller"].ToString() == "Beneficiary" ? "active" : "")">
                <i class="fas fa-users"></i> Beneficiaries
            </a>

            <div class="label" style="margin-top: 8px;">Planning</div>
            <a href="@Url.Action("Index", "Savings")" class="@(ViewContext.RouteData.Values["controller"].ToString() == "Savings" ? "active" : "")">
                <i class="fas fa-piggy-bank"></i> Savings
            </a>
            <a href="@Url.Action("Index", "Budget")" class="@(ViewContext.RouteData.Values["controller"].ToString() == "Budget" ? "active" : "")">
                <i class="fas fa-chart-pie"></i> Budget <span class="badge">AI</span>
            </a>

            <div class="label" style="margin-top: 8px;">Account</div>
            <a href="@Url.Action("Index", "Profile")" class="@(ViewContext.RouteData.Values["controller"].ToString() == "Profile" ? "active" : "")">
                <i class="fas fa-user-cog"></i> Profile
            </a>
            <a href="@Url.Action("Index", "Notification")" class="@(ViewContext.RouteData.Values["controller"].ToString() == "Notification" ? "active" : "")">
                <i class="fas fa-bell"></i> Notifications
                @if (ViewBag.UnreadCount != null && ViewBag.UnreadCount > 0)
                {
                    <span class="badge">@ViewBag.UnreadCount</span>
                }
            </a>

            @if (User.IsInRole("Admin"))
            {
                <div class="label" style="margin-top: 8px;">Admin</div>
                <a href="@Url.Action("Index", "Admin")" class="@(ViewContext.RouteData.Values["controller"].ToString() == "Admin" ? "active" : "")">
                    <i class="fas fa-shield-alt"></i> Admin Panel
                </a>
            }
        </nav>

        <div class="sidebar-footer">
            <div class="user">
                <div class="avatar">
                    @if (User.Identity.IsAuthenticated)
                    {
                        var n = User.Identity.Name;
                        @(n?.Substring(0,1).ToUpper() ?? "U")
                    }
                    else
                    { <span>U</span>}
                </div>
                <div class="info">
                    <div class="name">@if (User.Identity.IsAuthenticated)
                    {@User.Identity.Name }
                else
                { <span>Guest</span>}</div>
                    <div class="email">@if (User.Identity.IsAuthenticated)
                    {@User.Identity.Name }
                else
                { <span>Not logged in</span>}</div>
                </div>
                @if (User.Identity.IsAuthenticated)
                {
                    using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="logout"><i class="fas fa-sign-out-alt"></i></button>
                    }
                }
            </div>
        </div>
    </aside>

    <!-- ===== MAIN ===== -->
    <div class="main">

        <header class="header">
            <div class="left">
                <button class="toggle" id="toggleBtn"><i class="fas fa-bars"></i></button>
                <div class="title">
                    @ViewBag.Title
                    <small>@ViewBag.SubTitle</small>
                </div>
            </div>
            <div class="right">
                <button onclick="location.href='@Url.Action("Index", "Notification")'">
                    <i class="fas fa-bell"></i>
                    @if (ViewBag.UnreadCount != null && ViewBag.UnreadCount > 0)
                    {<span class="dot"></span>}
                </button>
                <button onclick="location.href='@Url.Action("Index", "Profile")'">
                    <i class="fas fa-user"></i>
                </button>
            </div>
        </header>

        <main class="content">
            @RenderBody()
        </main>

    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('overlay');
        const toggleBtn = document.getElementById('toggleBtn');

        toggleBtn?.addEventListener('click', function () {
            sidebar.classList.toggle('open');
            overlay.classList.toggle('show');
        });
        overlay?.addEventListener('click', function () {
            sidebar.classList.remove('open');
            overlay.classList.remove('show');
        });

        window.addEventListener('resize', function () {
            if (window.innerWidth > 992) {
                sidebar.classList.remove('open');
                overlay.classList.remove('show');
            }
        });
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>