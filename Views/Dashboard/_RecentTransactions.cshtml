@model IEnumerable<StandardBank.Models.Transaction>

<div class="card card-elegant">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-clock me-2"></i>Recent Transactions</span>
        <a href="@Url.Action("History", "Banking")" class="btn btn-sm btn-outline-primary">View All</a>
    </div>
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Amount</th>
                            <th>Type</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model)
                        {
                            <tr>
                                <td><small>@t.TransactionDate.ToString("dd MMM HH:mm")</small></td>
                                <td>@t.Description</td>
                                <td class="fw-bold @(t.TransactionType == "Credit" ? "text-success" : "text-danger")">
                                    @(t.TransactionType == "Credit" ? "+" : "-")@t.Amount.ToString("C")
                                </td>
                                <td>
                                    <span class="badge @(t.TransactionType == "Credit" ? "bg-success" : "bg-danger")">
                                        @t.TransactionType
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted text-center py-3">No recent transactions.</p>
        }
    </div>
</div>