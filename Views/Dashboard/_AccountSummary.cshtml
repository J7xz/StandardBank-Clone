@model IEnumerable<StandardBank.Models.Account>

<div class="card card-elegant">
    <div class="card-header">
        <i class="fas fa-wallet me-2"></i>Your Accounts
    </div>
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            foreach (var account in Model)
            {
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <div>
                        <h6 class="mb-0 fw-semibold">@account.AccountName</h6>
                        <small class="text-muted">@account.AccountNumber</small>
                        <span class="badge bg-@(account.AccountType == "Cheque" ? "primary" : account.AccountType == "Savings" ? "success" : "warning") ms-1">
                            @account.AccountType
                        </span>
                    </div>
                    <div class="text-end">
                        <span class="fw-bold">@account.Balance.ToString("C")</span>
                        <small class="d-block text-@(account.IsActive ? "success" : "danger")">
                            @(account.IsActive ? "Active" : "Closed")
                        </small>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted text-center py-3">No accounts found.</p>
        }
    </div>
</div>